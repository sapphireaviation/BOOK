# Required
DATABASE_URL=postgres://app:app@localhost:5432/booking
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Brand (public)
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# Sign in with Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional, without it emails are logged to the console)
RESEND_API_KEY=
EMAIL_FROM=

# Flights (optional, without it the flight vertical shows "not connected")
DUFFEL_ACCESS_TOKEN=

# Payments (at least one for real bookings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Natural language search (optional, falls back to a rule based parser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Listing photo uploads (optional in dev)
BLOB_READ_WRITE_TOKEN=

# Comma separated emails that become admins when they open /host or /admin
ADMIN_EMAILS=

# SEO
INDEXNOW_KEY=

# Protects /api/cron/* routes
CRON_SECRET=
