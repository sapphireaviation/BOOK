index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..ae755a87a48090cf5116c47acbe588d2decd92eb 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -175,8 +175,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       return write(toBuffer(q))
         && !q.describeFirst
         && !q.cursorFn
-        && sent.length < max_pipeline
-        && (!q.options.onexecute || q.options.onexecute(connection))
+        // Patched: run onexecute (used by sql.begin to reserve the connection) even when max_pipeline is 0,
